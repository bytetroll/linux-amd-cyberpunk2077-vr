+    // Converting a handle to one of its base classes. MSVC resolves a `static_cast<Handle<Base>>(derived)`
+    // by binding this to `Handle(const Handle&)` after the templated conversion operator below; clang
+    // also sees `explicit Handle(T*)` reached through SharedPtrWithAccess's implicit `operator T*()`,
+    // and reports the two user-defined conversions as ambiguous. Giving the conversion its own
+    // constructor -- taking the derived handle by reference, so the argument binds with an exact
+    // match and beats the pointer path outright -- pins the one path MSVC already takes.
+    template<typename U, typename = std::enable_if_t<std::is_base_of_v<T, U> && !std::is_same_v<T, U>>>
+    Handle(const Handle<U>& aOther) noexcept
+        : Handle(*reinterpret_cast<const Handle*>(&aOther))
+    {
+    }
+
     Handle(const Handle& aOther) noexcept
     {
         BaseType::CopyConstructFrom(aOther);
